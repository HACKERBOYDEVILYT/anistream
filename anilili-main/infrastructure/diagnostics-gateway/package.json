{
  "name": "anilili-diagnostics-gateway",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "dev:node": "tsx watch server/index.ts",
    "build:web": "vite build",
    "build": "npm run build:web && tsc -p tsconfig.cloudflare.json --noEmit",
    "build:node": "vite build && tsc -p tsconfig.server.json",
    "start:node": "node dist/server/index.js",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run --outdir dist/worker",
    "test": "npm run test:node && npm run test:worker",
    "test:node": "vitest run --config vitest.node.config.ts",
    "test:worker": "npm run build:web && vitest run --config vitest.worker.config.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.cloudflare.json --noEmit",
    "worker:types": "wrangler types",
    "worker:startup": "wrangler check startup"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.864.0",
    "aws4fetch": "^1.0.20",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.19.1",
    "@cloudflare/workers-types": "^5.20260730.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.17.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/supertest": "^6.0.3",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-react": "^4.7.0",
    "fflate": "^0.8.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.116.0"
  }
}
